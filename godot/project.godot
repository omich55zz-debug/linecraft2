; Engine configuration file.
; This file is committed; do not edit by hand normally.

config_version=5

[application]

config/name="Linecraft 2"
config/description="L2-style 3D RPG (Godot 4 port)"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/show_image=false

[autoload]

Selection="*res://scripts/Selection.gd"
SaveGame="*res://scripts/SaveGame.gd"
Quests="*res://scripts/Quests.gd"

[debug]

gdscript/warnings/exclude_addons=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

